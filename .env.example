VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable-aqui

# Chave secret (ex-service_role). Usada APENAS em scripts server-side (nunca no browser).
# Ex.: node scripts/seed-user.mjs
SUPABASE_SERVICE_KEY=sua-chave-secret-aqui

# Token da brapi.dev (usado apenas no servidor: proxy dev do Vite e função serverless /api/brapi).
# O nome mantém o prefixo VITE_ para que o `vercel --prod` envie a variável para o ambiente runtime.
VITE_BRAPI_TOKEN=seu-token-brapi-aqui
